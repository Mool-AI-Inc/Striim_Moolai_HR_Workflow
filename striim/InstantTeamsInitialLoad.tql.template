-- One-shot bulk copy of the Instant Teams ledger. Runs once, finishes, stops.
--
-- The CDC application must already be RUNNING before this starts. See InstantTeamsCDC.tql
-- for why: the slot has to be held before the bulk read, or writes landing during the copy
-- are lost silently.
--
-- DatabaseReader (not PostgreSQLReader): this reads the tables as they are, it does not
-- tail the write-ahead log. It has no slot and no LSN.

-- No CREATE NAMESPACE here. Striim rejects `CREATE NAMESPACE IF NOT EXISTS` as a
-- syntax error, whatever the documentation implies; the namespace is created once,
-- by hand, and this file only selects it.
USE __NS__;

CREATE APPLICATION InstantTeamsInitialLoad;

CREATE SOURCE LedgerBulkSource USING DatabaseReader (
  ConnectionURL: 'jdbc:postgresql://__HOST__/__SRCDB__?sslmode=require&stringtype=unspecified',
  Username: '__USER__',
  Password: '__PASS__',
  Tables: 'public.employees;public.send_ledger;public.sms_opt_out;public.pending_approvals',
  FetchSize: 1000,
  ConnectionRetryPolicy: 'retryInterval=30, maxRetries=3'
)
OUTPUT TO LedgerBulkStream;

CREATE TARGET LedgerBulkTarget USING DatabaseWriter (
  ConnectionURL: 'jdbc:postgresql://__HOST__/__TGTDB__?sslmode=require&stringtype=unspecified',
  Username: '__USER__',
  Password: '__PASS__',
  Tables: 'public.employees,public.employees;public.send_ledger,public.send_ledger;public.sms_opt_out,public.sms_opt_out;public.pending_approvals,public.pending_approvals',
  CommitPolicy: 'EventCount:1000,Interval:10',
  BatchPolicy: 'EventCount:1000,Interval:10',
  CheckpointTable: 'CHKPOINT',
  -- Same reason as the CDC app: the overlap window delivers rows twice by design.
  IgnorableExceptionCode: 'DUPLICATE_ROW_EXISTS,NO_OP_UPDATE,NO_OP_PKUPDATE,NO_OP_DELETE',
  ParallelThreads: 4,
  ConnectionRetryPolicy: 'retryInterval=30, maxRetries=3'
)
INPUT FROM LedgerBulkStream;

END APPLICATION InstantTeamsInitialLoad;
