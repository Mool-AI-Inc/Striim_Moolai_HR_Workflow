-- BambooHR landing -> the employees table the platform reads.
--
-- Column names below are the REAL ones the Striim BambooHR Reader created, read back from
-- information_schema after the first load. It lowercases everything and produces 20 columns.
-- Do not infer these from BambooHR's API docs; the reader's shape is its own.
--
-- WHAT IS NOT HERE, AND IT MATTERS:
--   hireDate, dateOfBirth, employmentHistoryStatus, payRate
-- The reader's `Employees` table maps to BambooHR's DIRECTORY, which only exposes public
-- directory fields. Hire date, date of birth, employment status and compensation are not in
-- that payload at any setting.
--
-- Consequences for the platform, stated plainly rather than papered over:
--   * hire_date is NULL  -> UC2a/UC2b (the Day-60 arc) cannot anchor. The durable timer has
--                           no start date.
--   * birth_date is NULL -> UC5 (birthdays) will never match.
--   * status defaults to 'A' -> we are ASSUMING everyone in the directory is active, which is
--                           usually true of a directory but is an assumption, not a fact.
-- Closing that gap needs either extra tables on the reader (jobInfo / employmentStatus) or a
-- BambooHR custom report. Until then this feed is good for identity, not for the timed arcs.
--
-- Idempotent: safe to re-run after every incremental load.

INSERT INTO employees (
  employee_id, first_name, last_name, email,
  birth_date, hire_date, employee_type, status,
  cost_center, phone, sms_consent, updated_at
)
SELECT
  b.id,
  COALESCE(NULLIF(b.firstname, ''), COALESCE(b.displayname, 'unknown')),
  COALESCE(NULLIF(b.lastname, ''), ''),
  COALESCE(NULLIF(b.workemail, ''), b.id || '@no-email.invalid'),
  NULL::date,                 -- not in the directory payload; see note above
  NULL::date,                 -- not in the directory payload; see note above
  -- No employment-status field arrives, so type cannot be derived. 'RFT' is the majority
  -- case in a directory and is flagged as an assumption rather than a reading.
  'RFT',
  'A',
  -- BambooHR's `department` is the closest thing to a cost centre. Free text, so it will not
  -- match the CC-* vocabulary UC6 keys off — mapped through, not invented.
  COALESCE(NULLIF(b.department, ''), 'CC-OPS'),
  COALESCE(NULLIF(b.mobilephone, ''), COALESCE(b.workphone, '')),
  -- NEVER infer SMS consent from an HRIS. A phone number is not permission to text it, and
  -- UC7 gates on this. False always; consent is captured separately and owned by us.
  false,
  now()
FROM bamboohr_employees b
WHERE b.id IS NOT NULL AND b.id <> ''
ON CONFLICT (employee_id) DO UPDATE SET
  first_name  = EXCLUDED.first_name,
  last_name   = EXCLUDED.last_name,
  email       = EXCLUDED.email,
  cost_center = EXCLUDED.cost_center,
  phone       = EXCLUDED.phone,
  -- sms_consent and the date columns are deliberately NOT overwritten: consent is ours, and
  -- dates may have been enriched from a better source than the directory.
  updated_at  = now();
