# ─────────────────────────────────────────────────────────────────────────────
# (1) THE SWITCH — the only knob that flips synthetic-demo ↔ live vendors.
#     env.ts derives every base URL + the data source from this. No other var gates live-ness.
# ─────────────────────────────────────────────────────────────────────────────
PLATFORM_MODE=demo            # demo | live

# ─────────────────────────────────────────────────────────────────────────────
# (2) SHARED INFRA — used in BOTH modes.
# ─────────────────────────────────────────────────────────────────────────────
SIMULATOR_URL=http://127.0.0.1:8085                     # the demo endpoint every connector points at
LEDGER_DATABASE_URL=postgres://instant:instant@127.0.0.1:5433/instant_ledger
TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_TEST_SERVER_PATH=                             # optional: pin the time-skipping test-server binary
# ANTHROPIC_API_KEY=                                     # optional: UC6 uses the Llm recommender when present
# UC6_MODEL=                                             # optional: model id for the UC6 recommender

# ─────────────────────────────────────────────────────────────────────────────
# (3) LIVE-ONLY VENDOR CREDENTIALS — blank in demo, required for live.
#     Cutover = set PLATFORM_MODE=live and fill this block.
# ─────────────────────────────────────────────────────────────────────────────
PAYLOCITY_BASE_URL=
PAYLOCITY_CLIENT_ID=
PAYLOCITY_CLIENT_SECRET=
POSTMARK_BASE_URL=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=hr@instant.test

# SMS / Slack / Vetty / WorkBright / Drive — live URLs + tokens (blank in demo)
SMS_BASE_URL=
SMS_TOKEN=
SLACK_BASE_URL=
SLACK_TOKEN=
VETTY_BASE_URL=
VETTY_TOKEN=
WORKBRIGHT_BASE_URL=
WORKBRIGHT_TOKEN=
DRIVE_BASE_URL=
DRIVE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# (4) INTERACTIVE DEMO — real Outlook/Graph email, sent natively (no external service to run).
#     Leave GRAPH_TENANT_ID blank to keep the interactive demo fully offline (in-memory sends).
#     Azure AD app registration with the Graph Mail.Send application permission (admin-consented);
#     mail is sent AS SENDER_EMAIL (a real, licensed M365 mailbox, e.g. platform@moolai.ai).
# ─────────────────────────────────────────────────────────────────────────────
GRAPH_TENANT_ID=                     # Directory (tenant) ID
GRAPH_CLIENT_ID=                     # Application (client) ID
GRAPH_CLIENT_SECRET=                 # client secret value
SENDER_EMAIL=                        # the sending mailbox, e.g. platform@moolai.ai
FROM_DISPLAY_NAME=MoolAI Platform    # optional — From display name
REPLY_TO_EMAIL=                      # optional — Reply-To; body always carries a do-not-reply notice
DEMO_EMAIL_TO=sarahm@moolai.ai     # ALL demo emails are delivered HERE (fixture addresses are fake/@instantteams.test)

# ─────────────────────────────────────────────────────────────────────────────
# (5) STRIIM MIGRATION + BAMBOOHR (leg 1: BambooHR -> Postgres, leg 2: ledger -> target)
#     None of this was documented here before, which is how `python striim/deploy.py deploy`
#     came to fail with "missing required environment variable MIGRATION_DB_HOST" for anyone
#     who had only sourced .env — the three MIGRATION_DB_* values existed solely in whoever's
#     shell had exported them. They are now DERIVED from LEDGER_DATABASE_URL and
#     TARGET_DATABASE_URL, and only need setting if the migration targets another cluster.
# ─────────────────────────────────────────────────────────────────────────────
TARGET_DATABASE_URL=                 # the cutover target; host/user/password shared with LEDGER_DATABASE_URL
LEDGER_MODE=memory                   # memory (default) | pg — pg is what reads the employees table

STRIIM_URL=https://developer.striim.com
STRIIM_USER=                         # Striim cluster login
STRIIM_PASS=
STRIIM_MIGRATION_NS=sarah_moolai     # namespace; created once by hand, CREATE NAMESPACE IF NOT EXISTS is rejected
STRIIM_DEPLOYMENT_GROUP=sarah_moolai_dg   # NOT "default" — no such group on this cluster; `LIST DEPLOYMENTGROUPS;` finds the real name
MIGRATION_SLOT=instant_teams_slot    # the Postgres replication slot; Striim does NOT create it

# Optional overrides — leave blank to derive from LEDGER_DATABASE_URL / TARGET_DATABASE_URL.
MIGRATION_DB_HOST=
MIGRATION_DB_USER=
MIGRATION_DB_PASS=
MIGRATION_SOURCE_DB=
MIGRATION_TARGET_DB=

# BambooHR. The DOMAIN is the subdomain only (e.g. trialea7f941c), never a full URL — the
# reader fails with "Please provide a valid value for Domain." otherwise. A trial that has
# EXPIRED does not fail as an auth error: the API answers 503 while the portal still
# redirects, and Striim reports it as a 404 on Table [Employees]. curl the tenant first.
BAMBOOHR_API_KEY=
BAMBOOHR_DOMAIN=
WATCH_INTERVAL_MS=30000              # npm run watch:bamboohr cycle; the Striim reader itself is floored at 300s

# ---- demo picker (added 2026-09-30) ----
# Which employees the dropdown shows. The employees table holds TWO populations: people from
# BambooHR (numeric ids) and 201 synthetic EMP_* rows from fixtures/employees.json. bamboohr
# shows only people the CURRENT tenant's directory lists. The fixture rows stay in the table —
# the migration exists to move them — they are just not offered in the picker.
ROSTER_SOURCE=bamboohr
ROSTER_LIMIT=10

# ─────────────────────────────────────────────────────────────────────────────
# (6) EMPLOYEE SYNC DEMO — BambooHR -> Striim -> PostgreSQL -> Workday
#     npm run syncdemo   ->   http://localhost:3000
#
#     Runs fully mocked with NO configuration at all if LEDGER_DATABASE_URL is set: it creates
#     its own `syncdemo` schema and never touches the platform's tables.
# ─────────────────────────────────────────────────────────────────────────────
SYNCDEMO_PORT=3000

# mock (default) | live. MOCK IS THE DEFAULT ON PURPOSE, even when credentials are present:
# in live mode, pressing Create Employee creates a REAL person in a real HRIS and writes a REAL
# row into a Workday Adaptive planning model that a pay-equity agent reads. Neither is reversible
# from the dashboard. Per-system overrides win over this:
#   SYNCDEMO_BAMBOOHR_MODE, SYNCDEMO_STRIIM_MODE, SYNCDEMO_WORKDAY_MODE
# A system set to live but missing credentials stays mocked and says so in the UI.
SYNCDEMO_MODE=mock

# Mock Striim's change-detection interval. Real Striim's BambooHR reader cannot go below 300s —
# the connector rejects anything faster — so this value is honest only about the mock.
SYNCDEMO_STRIIM_POLL_MS=1500
# How often the live adapter re-reads the real landing table.
SYNCDEMO_STRIIM_LIVE_POLL_MS=10000

# Database, in precedence order: SYNCDEMO_DATABASE_URL, then POSTGRES_*, then LEDGER_DATABASE_URL.
SYNCDEMO_DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=syncdemo
POSTGRES_USER=syncdemo
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=

# BambooHR — reuses BAMBOOHR_API_KEY / BAMBOOHR_DOMAIN from section (5). BAMBOOHR_BASE_URL is
# only for pointing at a stub during tests.
BAMBOOHR_BASE_URL=

# Workday. These names are accepted as aliases for the ADAPTIVE_* values in section (5), so a
# machine already configured for the Adaptive agent needs nothing new here.
WORKDAY_BASE_URL=
WORKDAY_TOKEN_URL=
WORKDAY_TOKEN_EXCHANGE_URL=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_REFRESH_TOKEN=

# Striim — reuses STRIIM_URL / STRIIM_USER / STRIIM_PASS from section (5).
# STRIIM_PASSWORD is accepted as an alias for STRIIM_PASS.
SYNCDEMO_STRIIM_APP=BambooHRToPostgres

# Point the test suite at a throwaway database. With none of these set the database-backed tests
# SKIP rather than fail, so `npm test` stays green without Postgres.
SYNCDEMO_TEST_DATABASE_URL=

# ---- Workday/Adaptive pre-allocated demo slots (added 2026-10-05) ----
# The ONLY members this pipeline may write to. slots.ts allocates exclusively from this list,
# which is what guarantees no existing employee is ever overwritten.
# Adaptive cannot create dimension members through the API available here (only exportData,
# exportSheets and importConfigurableModelData), so an admin must create these in the
# EmpID_EUPTD dimension. Check with:  npm run slots:check
ADAPTIVE_DEMO_SLOTS=EMP_9001,EMP_9002,EMP_9003,EMP_9004,EMP_9005,EMP_9006,EMP_9007,EMP_9008,EMP_9009,EMP_9010,EMP_9011,EMP_9012,EMP_9013,EMP_9014,EMP_9015,EMP_9016,EMP_9017,EMP_9018,EMP_9019,EMP_9020

# The INTERNAL level code, which is what Adaptive accepts. ADAPTIVE_LEVEL above holds the DISPLAY
# name and is rejected with "Invalid Level Choice". The real value is the third column of an
# exportData with useInternalCodes="true".
ADAPTIVE_LEVEL_CODE=SUPERVISORY_Workforce_Planning_Department

# The only writable column on the EUPTD import template. Headcount, Salary, Taxes,
# Tenure in Months and Total Compensation are each rejected with "Invalid header name(s)".
ADAPTIVE_METRIC_COLUMN=PY Pay

# Pin the period written (MM/YYYY). Blank = current month.
ADAPTIVE_WRITE_MONTH=

# ---- reverse pipeline: Workday -> Striim -> PostgreSQL -> BambooHR (added 2026-10-05) ----
# Separate process, separate port, separate Postgres schema, so it is a genuine fallback for the
# forward pipeline rather than a second view of it.
REVDEMO_PORT=3001
REVDEMO_SCHEMA=revdemo

# live: Workday is read for real (read-only, safe) AND BambooHR is written for real.
# A BambooHR create is PERMANENT -- that API has no delete, only termination -- and consumes a
# seat. Nothing imports automatically: an operator picks one person at a time and the UI confirms
# the consequence by name. Set REVDEMO_BAMBOOHR_MODE=mock to rehearse without touching the HRIS.
REVDEMO_MODE=live

# Adaptive carries no email and BambooHR requires a unique one, so it is synthesised as
# first.last.memberid@<domain>. A reserved example domain by default: these addresses land on
# permanent records, so the default must not look like a deliverable corporate address.
REVDEMO_EMAIL_DOMAIN=workday-import.example.com

# Hard cap per request. Bulk import of 523 Workday members would be 523 permanent HRIS records.
REVDEMO_MAX_PER_REQUEST=1

# The Adaptive account read for the employee list. PayRate gives one row per person plus their pay.
REVDEMO_WORKDAY_ACCOUNT=EUPTD_Demographics.PayRate
REVDEMO_READ_MONTH=
