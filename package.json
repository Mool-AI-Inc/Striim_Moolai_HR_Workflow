{
  "name": "instant-teams-mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:temporal": "vitest run --config vitest.temporal.config.ts",
    "test:integration": "vitest run --project integration",
    "test:writeback": "tsx --env-file-if-exists=.env scripts/test-writeback.ts",
    "push:adaptive": "tsx --env-file-if-exists=.env scripts/push-to-adaptive.ts",
    "watch:bamboohr": "tsx --env-file-if-exists=.env scripts/watch-bamboohr.ts",
    "enrich:bamboohr": "tsx --env-file-if-exists=.env scripts/enrich-bamboohr.ts",
    "reconcile:bamboohr": "tsx --env-file-if-exists=.env scripts/reconcile-bamboohr.ts",
    "load:employees": "tsx --env-file-if-exists=.env scripts/load-employees.ts",
    "gen:data": "tsx scripts/generate-demo-data.ts",
    "gen:packets": "tsx scripts/generate-packets.ts",
    "demo": "tsx scripts/demo.ts",
    "interactive": "tsx --env-file-if-exists=.env scripts/interactive.ts",
    "up": "tsx --env-file-if-exists=.env scripts/up.ts",
    "syncdemo": "tsx --env-file-if-exists=.env src/syncdemo/server/index.ts",
    "reversedemo": "tsx --env-file-if-exists=.env src/reversedemo/server/index.ts",
    "show:db": "tsx --env-file-if-exists=.env scripts/show-db.ts",
    "slots:check": "tsx --env-file-if-exists=.env scripts/check-adaptive-slots.ts",
    "syncdemo:test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project syncdemo",
    "ui:dev": "vite --config src/platform/approval-app/vite.config.ts",
    "bakeoff": "tsx scripts/model-bakeoff.ts",
    "lint:isolation": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/platform/worker.ts",
    "ingress": "tsx src/platform/ingress.ts",
    "simulator": "tsx simulator/saasSimulator.ts",
    "sync:bamboohr": "tsx --env-file-if-exists=.env scripts/sync-bamboohr.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@temporalio/testing": "^1.22.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "^18.2.0",
    "execa": "^10.0.1",
    "jsdom": "^30.0.1",
    "pdfkit": "^0.19.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
